# Optional overrides. Copy to .env (git-ignored) and fill in. Never commit real values.
ETH_RPC_URL=
TRONGRID_API_KEY=
ARBITRUM_RPC_URL=
BASE_RPC_URL=
POLYGON_RPC_URL=
AVALANCHE_RPC_URL=
SOLANA_RPC_URL=
HELIUS_API_KEY=
# or point at a file containing the key instead:
HELIUS_API_KEY_FILE=
# Output adapters. Nostr/Mastodon are stubs; Telegram is implemented. Not used unless --live.
NOSTR_NSEC=
NOSTR_RELAYS=
MASTODON_BASE_URL=
MASTODON_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=
# or point at a file containing the bot token instead of the var above:
TELEGRAM_BOT_TOKEN_FILE=
# channel to post to: @channelusername or a numeric -100... id
TELEGRAM_CHAT_ID=
